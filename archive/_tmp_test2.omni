import OMNISYS.core
fn clamp_value(v: Number) -> Number:
    pure
    if v > 255:
        return 255
    if v < 0:
        return 0
    return v

fn make_synthetic_frames(fps: Number, num_frames: Number, width: Number, height: Number) -> Timeline:
    pure
    show "generating"
end

when app starts:
    show "done"
end