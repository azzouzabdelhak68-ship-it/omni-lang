# Probe 3B: with `uses secrets` -> should pass
import OMNISYS.auth

fn good_hash(password: Text, salt: Text) -> Text:
    uses secrets
    return omnisys.auth.hash_password(password, salt)
end

fn check_pw(password: Text, hash: Text) -> Boolean:
    uses secrets
    return omnisys.auth.verify_password(password, hash)
end

when app starts:
    h = good_hash("hunter2", "pepper")
    show "hash: " + h
    ok = check_pw("hunter2", h)
    show "verified: " + ok
end