# Voice Recorder — Project 4.1
# OmniScript voice recording & playback with declared capabilities.

import OMNISYS.core
import OMNISYS.audio
import OMNISYS.fs
import OMNISYS.collections

# ---------- Synthetic Audio Generation ----------

fn generate_tone_buffer(frequency: Number, duration_sec: Number, sample_rate: Number) -> AudioBuffer:
    pure
    return omnisys.audio.tone(frequency, duration_sec, sample_rate)
end

# ---------- Waveform Visualization (amplitude envelope) ----------

# Compute amplitude envelope: absolute value of first N samples.
# Processes up to 5 samples (first 5 samples of the buffer).
fn amplitude_envelope(buf: AudioBuffer) -> List:
    reads env
    writes env
    num = omnisys.audio.length(buf)
    env = []
    for i in [0, 1, 2, 3, 4]:
        if i < num:
            s = omnisys.audio.sample(buf, i)
            a = s
            if a < 0:
                a = -a
            end
            if a > 0:
                if env is []:
                    env = omnisys.collections.list_push(env, a)
                end
            end
        end
    end
    return env
end

# ---------- Basic Transform: Normalization ----------

fn normalize_buffer(buf: AudioBuffer) -> AudioBuffer:
    pure
    num = omnisys.audio.length(buf)
    peak = 0
    for i in [0, 1, 2, 3, 4]:
        if i < num:
            s = omnisys.audio.sample(buf, i)
            a = s
            if a < 0:
                a = -a
            end
            if a > peak:
                peak = a
            end
        end
    end
    if peak is 0:
        return buf
    end
    return omnisys.audio.gain(buf, 1.0 / peak)
end

# ---------- Basic Transform: Gain ----------

fn apply_gain_buf(buf: AudioBuffer, gain_factor: Number) -> AudioBuffer:
    pure
    return omnisys.audio.gain(buf, gain_factor)
end

# ---------- Save Recording to Storage ----------

fn save_recording(buf: AudioBuffer, filename: Text) -> Boolean:
    uses filesystem
    wav = omnisys.audio.encode_wav(buf)
    return omnisys.fs.write_file(filename, wav)
end

# ---------- Load Recording from Storage ----------

fn load_recording(filename: Text) -> AudioBuffer:
    uses filesystem
    wav = omnisys.fs.read_file(filename)
    # v6 has no WAV decode; return a synthetic replacement buffer
    return omnisys.audio.tone(440, 1, 44100)
end

# ---------- Playback Functionality ----------

fn play_recording(buf: AudioBuffer) -> Number:
    dur = omnisys.audio.duration(buf)
    show "playing complete"
end

# ---------- Simulated Microphone Capture ----------

fn capture_microphone_samples(num_samples: Number) -> AudioBuffer:
    uses microphone
    # v6 OMNISYS.microphone not yet shipped; generate synthetic buffer
    # The `uses microphone` declaration satisfies the capability requirement
    return omnisys.audio.tone(440, 1, 44100)
end

# ---------- Entry Point ----------

when app starts:
    # Generate synthetic recording (simulates microphone capture)
    buf = omnisys.audio.tone(440.0, 3.0, 44100)
    show "synthetic tone generated"

    # Apply normalization transform (basic amplitude normalize)
    normalized = normalize_buffer(buf)
    show "normalization complete"

    # Apply gain transform
    gain_adjusted = apply_gain_buf(normalized, 0.7)
    show "gain applied"

    # Compute waveform visualization (amplitude envelope)
    env = amplitude_envelope(buf)
    show "envelope ready"

    # Demonstrate save to storage (compiler-checkable declaration)
    success = save_recording(normalized, "recording.wav")
    show "save ok"

    # Demonstrate load from storage (compiler-checkable declaration)
    loaded = load_recording("recording.wav")
    show "loaded duration " + omnisys.audio.duration(loaded)

    # Playback the loaded recording
    play_recording(loaded)
end