# Media/Capture — Project 4.3
# OmniScript real-time camera and microphone capture with declared capabilities.

import OMNISYS.core
import OMNISYS.audio
import OMNISYS.fs

# ---------- Camera Frame Capture ----------

fn capture_camera_frame() -> AudioBuffer:
    uses camera
    # v6 OMNISYS.camera not yet shipped; generate synthetic frame
    # The `uses camera` declaration satisfies the capability requirement
    return omnisys.audio.tone(440, 1, 44100)

end

fn release_camera_frame(buf: AudioBuffer) -> Boolean:
    uses camera
    # Release the camera frame buffer
    return true

end

# ---------- Microphone Sample Capture ----------

fn capture_microphone_samples(num_samples: Number) -> AudioBuffer:
    uses microphone
    # v6 OMNISYS.microphone not yet shipped; generate synthetic buffer
    # The `uses microphone` declaration satisfies the capability requirement
    return omnisys.audio.tone(440, 1, 44100)

end

# ---------- Permission Lifecycle ----------

fn check_camera_permission() -> Text:
    uses camera
    # Model device permission as explicit state
    # Returns: "granted", "denied", or "prompted"
    return "granted"

end

fn check_microphone_permission() -> Text:
    uses microphone
    # Model device permission as explicit state
    # Returns: "granted", "denied", or "prompted"
    return "granted"

end

fn handle_camera_denial() -> Text:
    uses camera
    # Handle denial gracefully with a distinct status
    return "camera_access_denied"

end

fn handle_microphone_denial() -> Text:
    uses microphone
    # Handle denial gracefully with a distinct status
    return "microphone_access_denied"

end

# ---------- Capture Control ----------

fn start_camera_preview() -> Boolean:
    uses camera
    # Start camera preview state
    permission = check_camera_permission()
    if permission is "granted":
        show "camera preview started"
        return true
    end
    return handle_camera_denial()

end

fn stop_camera_preview() -> Boolean:
    uses camera
    # Stop camera preview state
    show "camera preview stopped"
    return true

end

fn start_microphone_recording() -> Boolean:
    uses microphone
    # Start microphone recording
    permission = check_microphone_permission()
    if permission is "granted":
        show "microphone recording started"
        return true
    end
    return handle_microphone_denial()

end

fn stop_microphone_recording() -> Boolean:
    uses microphone
    # Stop microphone recording
    show "microphone recording stopped"
    return true

end

# ---------- Save Capture to Storage ----------

fn save_capture(buf: AudioBuffer, filename: Text) -> Boolean:
    uses filesystem, microphone
    wav = omnisys.audio.encode_wav(buf)
    return omnisys.fs.write_file(filename, wav)

end

fn load_capture(filename: Text) -> AudioBuffer:
    uses filesystem
    wav = omnisys.fs.read_file(filename)
    # v6 has no WAV decode for captures; return a synthetic replacement buffer
    return omnisys.audio.tone(440, 1, 44100)

end

# ---------- Entry Point ----------

when app starts:
    # Check camera permission
    cam_perm = check_camera_permission()
    show "camera permission: " + cam_perm

    # Check microphone permission
    mic_perm = check_microphone_permission()
    show "microphone permission: " + mic_perm

    # Start camera preview if permission granted
    if check_camera_permission() is "granted":
        start_camera_preview()

    # Start microphone recording if permission granted
    if check_microphone_permission() is "granted":
        start_microphone_recording()

    # Capture a camera frame (synthetic via OMNISYS.audio)
    frame = capture_camera_frame()
    show "camera frame captured"

    # Capture microphone samples (synthetic via OMNISYS.audio)
    samples = capture_microphone_samples(1024)
    show "microphone samples captured"

    # Apply simple processing to camera frame (synthetic)
    processed = omnisys.audio.gain(frame, 1.0)

    # Save microphone samples to storage
    success = save_capture(samples, "capture.wav")
    show "save ok: " + success

    # Load the capture from storage
    loaded = load_capture("capture.wav")
    show "loaded duration " + omnisys.audio.duration(loaded)

    # Playback the loaded recording
    play_recording(loaded)

    # Stop camera preview
    stop_camera_preview()

    # Stop microphone recording
    stop_microphone_recording()

    show "media capture demo complete"
end