            locked=true,
            required_key="iron_key",
            connections=["armory"],
            items=["iron_key", "map"]
        )
    ]

    items_db = [
        Item(
            id="torch",
            name="Torch",
            description="A wooden torch, unlit.",
            is_key=false,
            unlocks_room=""
        ),
        Item(
            id="golden_key",
            name="Golden Key",
            description="An ornate golden key.",
            is_key=true,
            unlocks_room="chamber"
        ),
        Item(
            id="sword",
            name="Rusty Sword",
