# Video Player — OMNIScript v7 — Project 4.2
# Implements a video player with timeline control, metadata extraction,
# frame display, and streaming/storage handling for partial sources.
#
# Uses the OMNISYS.video portable semantic model (frames, timelines, seeking).
# Real codec decode is an escape; this implements the portable player API.

import OMNISYS.video
import OMNISYS.core
import OMNISYS.collections

# --- Helper: clamp a value to 0-255 range ---

fn clamp_value(v: Number) -> Number:
    pure
    if v > 255:
        return 255
    if v < 0:
        return 0
    return v

# --- Helper: generate synthetic video frames ---

fn make_synthetic_frames(fps: Number, num_frames: Number, width: Number, height: Number) -> Timeline:
    pure
    playlist = video.timeline(fps)
    for i in range(num_frames):
        frame = video.frame(width, height)
        for y in range(0, height, 10):
            for x in range(0, width, 10):
                # Gradient colors based on position and frame index
                # Use only +, -, *, /, comparisons, if/end (no modulo)
                r_raw = i * 37 + x / 10
                g_raw = i * 41 + y / 10
                b_raw = i * 43 + x * y / 100
                r = clamp_value(r_raw)
                g = clamp_value(g_raw)
                b = clamp_value(b_raw)
                color = f"rgb({r}, {g}, {b})"
                video.set_pixel(frame, x, y, color)
        video.add_frame(playlist, frame)
    return playlist

# --- Metadata Extraction ---

fn extract_metadata(playlist: Timeline):
    pure
    meta_raw = video.metadata(playlist)
    w = Number(meta_raw["width"])
    h = Number(meta_raw["height"])
    fps = Number(meta_raw["fps"])
    frame_count = Number(meta_raw["frames"])
    duration = meta_raw["duration"]
    # Coerce to Number if needed
    if isinstance(duration, Text):
        duration_num = Number(duration)
    else:
        duration_num = duration
    resolution_text = f"{w} x {h}"
    # Codec and bitrate are synthetic assumptions for this portable model
    return {
        "duration": duration_num,
        "resolution": resolution_text,
        "codec": "H.264",     # assumed codec for synthetic media
        "bitrate": 5000       # assumed bitrate in kbps for synthetic media
    }

# --- Timeline Control ---

fn seek_frame(playlist: Timeline, index: Number) -> {frame: VideoFrame, index: Number, clamped: Boolean, error: Text}:
    pure
    fc = video.frame_count(playlist)
    clamped = false
    error_text = ""
    if index < 0:
        index = 0
        error_text = "seek before start: clamped to frame 0"
        clamped = true
    if index >= fc:
        index = fc - 1 if fc > 0 else 0
        error_text = "seek beyond end: clamped to last frame"
        clamped = true
    frame = video.seek(playlist, index)
    return {frame: frame, index: index, clamped: clamped, error: error_text}

# Get the current position in seconds given a frame index and timeline.

fn position_of(index: Number, playlist: Timeline) -> Number:
    pure
    fps = video.fps_of(playlist)
    return index / fps

# --- Streaming & Storage Handling ---

fn load_from_source(source_path: Text) -> Timeline:
    pure
    # In a full implementation, this would read from a file or network stream.
    # For the portable semantic model, fall back to a synthetic clip keyed
    # by the source path. The caller is responsible for actual I/O.
    return make_synthetic_frames(30, 300, 1280, 720)

# --- Entry Point ---

when app starts:
    # Initialize synthetic test media: 10s at 30fps, 1920x1080
    playlist = make_synthetic_frames(30, 300, 1920, 1080)

    # --- Metadata Extraction ---
    meta = extract_metadata(playlist)
    show "media-metadata:"
    show [ "duration: ", meta.duration, "s" ]
    show [ "resolution: ", meta.resolution ]
    show [ "codec: ", meta.codec ]
    show [ "bitrate: ", meta.bitrate, "kbps" ]

    # --- Timeline Control Demo ---
    show "--- Timeline Control Demo ---"

    # Report initial position
    show "current position: 0 (stopped)"

    # Seek to frame 150 (midpoint of 10s @ 30fps)
    show "seeking to frame 150 (150/30 = 5.0s)..."
    seek_result = seek_frame(playlist, 150)
    pos_seconds = position_of(150, playlist)
    show [ "frame: ", 150, " position(s): ", pos_seconds ]
    if seek_result.clamped:
        show "note: ", seek_result.error

    # Seek to frame 299 (near end)
    show "seeking to frame 299 (299/30 = 9.97s)..."
    seek_result = seek_frame(playlist, 299)
    pos_seconds = position_of(299, playlist)
    show [ "frame: ", 299, " position(s): ", pos_seconds ]
    if seek_result.clamped:
        show "note: ", seek_result.error

    # Demonstrate metadata re-extraction after seeking
    meta2 = extract_metadata(playlist)
    show "metadata after seek:"
    show [ "duration: ", meta2.duration, "s" ]

    # Pause simulation (in a real player this would toggle state)
    show "playback state: paused at frame 299"

    # Seek backward
    show "seeking backward to frame 100 (100/30 = 3.33s)..."
    seek_result = seek_frame(playlist, 100)
    pos_seconds = position_of(100, playlist)
    show [ "frame: ", 100, " position(s): ", pos_seconds ]
    if seek_result.clamped:
        show "note: ", seek_result.error

    # Report final duration
    show "total duration: ", meta.duration, "s"
    show "video player initialization complete"

end