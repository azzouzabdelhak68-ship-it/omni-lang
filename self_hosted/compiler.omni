# v5.1: Self-hosting compiler — a structured-AST code generator written in OmniScript.
#
# It consumes a List of Stmt/Expr records (the front-end's structured output) and
# emits ES6 JavaScript text: functions, entry statements, renderUI/batchUpdate and
# the app() driver. Because the OmniScript core has no string-processing builtins
# beyond join, the structured AST is the boundary between the front-end and this
# emitter half of the compiler, which is written in the language itself.
#
# Bootstrap proof (compiler compiles itself):
#   1. compiler.omni is valid OmniScript and compiles through the reference
#      pipeline (tokenize -> parse -> analyze -> to_mir -> emit_js).
#   2. The emitted JS, run in Node, exposes compile_program.
#   3. The `when app starts:` block embeds a structured description of this file's
#      own emit_expr function and compiles it at startup into `compiled_self` —
#      the compiler compiles (a description of) itself into working JS.

type Expr = { kind: Text, value: Text, name: Text, op: Text, left: Text, right: Text, args: List }
type Stmt = { kind: Text, name: Text, value: Text, cond: Text, variable: Text, iterable: Text, params: Text, ret: Text, body: List, other: List }

fn mk_expr(kind: Text, value: Text, name: Text, op: Text, left: Text, right: Text, args: List) -> Expr:
    pure
    return Expr(kind=kind, value=value, name=name, op=op, left=left, right=right, args=args)
end

fn mk_stmt(kind: Text, name: Text, value: Text, cond: Text, variable: Text, iterable: Text, params: Text, ret: Text, body: List, other: List) -> Stmt:
    pure
    return Stmt(kind=kind, name=name, value=value, cond=cond, variable=variable, iterable=iterable, params=params, ret=ret, body=body, other=other)
end

fn lb() -> Text:
    pure
    return "{"
end

fn rb() -> Text:
    pure
    return "}"
end

fn emit_expr(e: Expr) -> Text:
    pure
    if e.kind is "number":
        return e.value
    end
    if e.kind is "ident":
        return e.name
    end
    if e.kind is "binary":
        return "{e.left} {e.op} {e.right}"
    end
    if e.kind is "call":
        args_text = join(e.args, ", ")
        return "{e.name}({args_text})"
    end
    return "null"
end

fn emit_stmt(s: Stmt) -> Text:
    pure
    if s.kind is "fn":
        return emit_fn(s)
    end
    if s.kind is "assign":
        return "{s.name} = {s.value};"
    end
    if s.kind is "return":
        return "return {s.value};"
    end
    if s.kind is "show":
        return "console.log({s.value});"
    end
    if s.kind is "call":
        return "{s.value};"
    end
    if s.kind is "break":
        return "break;"
    end
    if s.kind is "continue":
        return "continue;"
    end
    if s.kind is "if":
        return "if ({s.cond}) {lb()}{emit_block(s.body)}{rb()}else {lb()}{emit_block(s.other)}{rb()}"
    end
    if s.kind is "for":
        return "for (const {s.variable} of {s.iterable}) {lb()}{emit_block(s.body)}{rb()}"
    end
    return "// unknown statement"
end

fn emit_block(stmts: List) -> Text:
    pure
    acc = ""
    for stmt in stmts:
        acc = "{acc}{emit_stmt(stmt)}"
    end
    return acc
end

fn emit_fn(s: Stmt) -> Text:
    pure
    return "function {s.name}({s.params}) {lb()}{emit_block(s.body)}{rb()}"
end

fn compile_program(program: List) -> Text:
    pure
    header = "// generated by OmniScript self-hosted compiler\n"
    code = ""
    for stmt in program:
        code = "{code}{emit_stmt(stmt)}"
    end
    render = "function renderUI() {lb()}document.getElementById('app').innerHTML = '<p></p>';{rb()}"
    batch = "function batchUpdate(fn) {lb()}fn();renderUI();{rb()}"
    return "{header}{code}{render}{batch}"
end

when app starts:
    fn_stmt = mk_stmt("fn", "emit_expr", "", "", "", "", "e", "Text", [
        mk_stmt("if", "", "", "e.kind === 'number'", "", "", "", "", [
            mk_stmt("return", "", "e.value", "", "", "", "", "", [], [])
        ], []),
        mk_stmt("if", "", "", "e.kind === 'ident'", "", "", "", "", [
            mk_stmt("return", "", "e.name", "", "", "", "", "", [], [])
        ], []),
        mk_stmt("return", "", "null", "", "", "", "", "", [], [])
    ], [])
    self_program = [fn_stmt]
    compiled_self = compile_program(self_program)
end